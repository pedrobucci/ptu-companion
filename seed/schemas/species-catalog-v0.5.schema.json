{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptu-companion.local/schemas/species-catalog-v0.5.json",
  "title": "PTU Companion Species Catalog Row",
  "type": "object",
  "required": [
    "species_key",
    "display_name",
    "types",
    "mechanical_completeness",
    "enabled_for_character_creation"
  ],
  "properties": {
    "species_key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "national_dex_number": {
      "type": [
        "integer",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "definition_id": {
      "type": "string"
    },
    "mechanical_completeness": {
      "type": "string"
    },
    "enabled_for_character_creation": {
      "type": "boolean"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}