{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTU Content Pack",
  "type": "object",
  "required": [
    "manifest",
    "content"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "priority"
      ]
    },
    "content": {
      "type": "object"
    }
  }
}