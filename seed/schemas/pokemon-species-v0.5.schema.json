{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptu-companion.local/schemas/pokemon-species-v0.5.json",
  "title": "PTU Companion PokemonSpeciesDefinition v0.5",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "types",
    "mechanical_completeness",
    "enabled_for_character_creation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "national_dex_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "display_dex_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 2
    },
    "base_stats": {
      "type": "object"
    },
    "ability_slots": {
      "type": "array"
    },
    "level_up_moves": {
      "type": "array"
    },
    "tm_moves": {
      "type": "array"
    },
    "egg_moves": {
      "type": "array"
    },
    "tutor_moves": {
      "type": "array"
    },
    "height": {
      "type": "object"
    },
    "weight": {
      "type": "object"
    },
    "gender_ratio": {
      "type": "object"
    },
    "egg_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "habitats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type_defense_profile": {
      "type": "object"
    },
    "ptu_evolution_stages": {
      "type": "array"
    },
    "mechanical_completeness": {
      "type": "string"
    },
    "enabled_for_character_creation": {
      "type": "boolean"
    },
    "missing_mechanical_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_validation": {
      "type": "object"
    },
    "search_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}