{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PTU Companion",
  "version": "2.2.0-beta.19",
  "identifier": "com.ptu.companion",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PTU Companion",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Companion offline para Pokemon Tabletop United",
    "longDescription": "Ficha de Trainer e Pokemon, rosters, itens, storage, shop, NPCs, progressao e regras PTU para uso offline.",
    "android": {
      "minSdkVersion": 24,
      "versionCode": 2002019
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
