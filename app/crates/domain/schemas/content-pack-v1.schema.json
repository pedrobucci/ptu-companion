{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptu-companion.local/schemas/content-pack-v1.schema.json",
  "title": "PTU Content Pack Manifest v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "format_version",
    "id",
    "name",
    "version",
    "priority",
    "dependencies",
    "content_counts",
    "files"
  ],
  "properties": {
    "format": {
      "const": "ptu-content-pack"
    },
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "browse_only": {
      "type": "boolean"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "content_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sha256",
          "bytes",
          "records"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    }
  }
}
