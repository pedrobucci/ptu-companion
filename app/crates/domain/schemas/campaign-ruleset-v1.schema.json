{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptu-companion.local/schemas/campaign-ruleset-v1.schema.json",
  "title": "PTU Campaign Ruleset v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "packs",
    "version_pins"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "enabled",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer"
          }
        }
      }
    },
    "version_pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gm_overrides_enabled": {
      "type": "boolean"
    }
  }
}
