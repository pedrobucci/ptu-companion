{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTU prerequisite semantic node",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "op",
        "kind",
        "raw"
      ],
      "properties": {
        "op": {
          "const": "leaf"
        },
        "kind": {
          "type": "string"
        },
        "raw": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "op",
        "children"
      ],
      "properties": {
        "op": {
          "enum": [
            "all",
            "any"
          ]
        },
        "raw": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "additionalProperties": true
    }
  ]
}